# ---- Builder stage ----
FROM python:3.12-slim AS builder

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ui --no-install-project

# Copy only the code this service needs (the UI imports config + src for
# its in-process fallback, so ship the package, but no data or model)
COPY config.py ./
COPY src/ ./src/


# ---- Final stage ----
FROM python:3.12-slim

WORKDIR /app

# Bring over the built virtual environment and code from the builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/config.py ./config.py
COPY --from=builder /app/src ./src

ENV PATH="/app/.venv/bin:$PATH"
# Call the FastAPI service by default; docker-compose.yml sets the same value.
ENV API_URL=http://api:8000

EXPOSE 8501

CMD ["streamlit", "run", "src/ui/customer_segmentation.py", "--server.address=0.0.0.0", "--server.port=8501"]
